<Window x:Class="StreamlootsManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Streamloots Gifter" Icon="Assets/StreamlootsGifter.ico" Width="1320" Height="880" MinWidth="980" MinHeight="680" WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Image Source="Assets/StreamlootsGifter.ico" Width="20" Height="20" Margin="0,0,9,0"/>
          <TextBlock Text="Streamloots Gifter" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="MinimizeWindowButton" Style="{StaticResource CaptionButtonStyle}" Content="−" Width="44" Height="35" MinHeight="0" Background="Transparent" FontSize="16" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow_Click"/>
          <Button x:Name="MaximizeRestoreButton" Style="{StaticResource CaptionButtonStyle}" Content="□" Width="44" Height="35" MinHeight="0" Background="Transparent" FontSize="13" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleWindowSize_Click"/>
          <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="×" Width="46" Height="35" MinHeight="0" Padding="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Symbol" FontSize="19" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow_Click"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid x:Name="LoginScreen" Grid.Row="1" Visibility="Visible">
      <TextBlock x:Name="LoginVersionLabel" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,14"
                 FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
      <Grid x:Name="LoginContentGroup" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="460"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border x:Name="LoginCard" Grid.Column="0" VerticalAlignment="Center" Padding="34" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22">
          <StackPanel>
            <TextBlock Text="STREAMLOOTS GIFTER" Foreground="#91A4FF" FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
            <TextBlock Text="Welcome back" FontSize="28" FontWeight="Bold"/>
            <TextBlock Text="Connect Twitch to open your gifting dashboard." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,24"/>
            <TextBlock x:Name="LoginStatus" Text="Not connected" Foreground="{DynamicResource MutedBrush}" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="390" Margin="0,0,0,6"/>
            <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{DynamicResource RedBrush}" Margin="0,0,0,12"/>
            <Button x:Name="LoginButton" Content="Continue with Twitch" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" Height="42" Click="LoginButton_Click"/>
          </StackPanel>
        </Border>
        <Button x:Name="LoginHelpButton" Grid.Column="0" Content="?" Width="54" Height="54" Margin="0,0,12,0" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Panel.ZIndex="2"
                FontSize="28" FontWeight="Bold" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                ToolTip="Twitch login setup guide" Click="LoginHelpButton_Click"/>
        <Border x:Name="LoginHelpPanel" Grid.Column="1" Width="520" MaxHeight="740" Margin="18,0,0,0" Visibility="Collapsed"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource ButtonBrush}" CornerRadius="18,18,0,0" Padding="22,18">
              <Grid>
                <StackPanel>
                  <TextBlock Text="Twitch login setup" FontSize="22" FontWeight="Bold"/>
                  <TextBlock Text="Follow these steps once, then sign in." Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Width="36" Height="36" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Background="{DynamicResource InputBrush}" Click="LoginHelpButton_Click" ToolTip="Close setup guide">
                  <Grid Width="10" Height="10">
                    <Border Width="10" Height="1.5" Background="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.RenderTransform><RotateTransform Angle="45"/></Border.RenderTransform></Border>
                    <Border Width="10" Height="1.5" Background="{DynamicResource TextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><Border.RenderTransform><RotateTransform Angle="-45"/></Border.RenderTransform></Border>
                  </Grid>
                </Button>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,18">
              <StackPanel>
                <TextBlock Text="1  Connect your Twitch account" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="Click Continue with Twitch on the login screen. The app opens Twitch's official activation page and displays a one-time code." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                <Button Content="Open Twitch activation page" HorizontalAlignment="Left" Background="{DynamicResource ButtonBrush}" Click="OpenTwitchActivation_Click"/>
                <TextBlock Text="2  Approve access on Twitch" FontSize="16" FontWeight="Bold" Margin="0,20,0,8"/>
                <TextBlock Text="Sign in on twitch.tv if needed, enter the code shown in the app, and approve the requested permissions. The code is copied to your clipboard automatically." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="3  Return to Streamloots Gifter" FontSize="16" FontWeight="Bold" Margin="0,20,0,8"/>
                <TextBlock Text="The app completes the connection automatically. Your Twitch password is entered only on Twitch; no Client Secret or .env setup is needed." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                  <TextBlock Text="The app stores its rotating Twitch session encrypted for your Windows account. If Twitch access expires or is revoked, connect again." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                </Border>
                <TextBox Text="https://dev.twitch.tv/docs/authentication/getting-tokens-oauth/" IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MinHeight="36"/>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
              <Button Content="Copy setup instructions" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="White" Click="CopyLoginGuide_Click"/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid x:Name="DashboardScreen" Grid.Row="1" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Background="{DynamicResource PanelBrush}">
        <DockPanel LastChildFill="True" Margin="14,0">
          <Button x:Name="SettingsBackButton" DockPanel.Dock="Left" Width="42" Height="42" Padding="0" Margin="0,0,12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource ButtonBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ToolTip="Back to dashboard" Visibility="Collapsed" Click="SettingsBack_Click">
            <Path Data="M 13,9 L 2,9 M 2,9 L 7,4 M 2,9 L 7,14" Width="18" Height="18" Stretch="None" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <Button x:Name="AddWidgetButton" DockPanel.Dock="Right" Content="＋  Edit layout" Height="38" Margin="0,0,12,0" Background="{DynamicResource AccentBrush}" Foreground="White" Click="AddWidgetButton_Click"/>
          <Button x:Name="ProfileButton" DockPanel.Dock="Right" Width="48" Height="48" Padding="0" Background="Transparent" Click="ProfileButton_Click" ContextMenuOpening="ProfileButton_ContextMenuOpening">
            <Ellipse x:Name="ProfileEllipse" Width="40" Height="40" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5" MouseEnter="Profile_MouseEnter" MouseLeave="Profile_MouseLeave">
              <Ellipse.RenderTransform><ScaleTransform x:Name="ProfileScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
            </Ellipse>
            <Button.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Twitch account" IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Log out" Click="Logout_Click"/>
              </ContextMenu>
            </Button.ContextMenu>
          </Button>
          <TextBlock x:Name="DashboardVersionLabel" DockPanel.Dock="Right" TextAlignment="Center" FontSize="11"
                     Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="0,0,16,0">
            <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}" Margin="0,0,8,0"/>
            <TextBlock x:Name="ConnectionStatus" Text="Connected" Foreground="{DynamicResource GreenBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
            <TextBlock x:Name="HeaderTitle" Text="Streamloots Gifter" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
            <Grid x:Name="SettingsSearchHost" Width="250" Height="36" Margin="18,4,0,0" Visibility="Collapsed">
              <TextBox x:Name="SettingsSearchBox" Padding="10,6" VerticalContentAlignment="Center" ToolTip="Search settings" TextChanged="SettingsSearchBox_TextChanged"/>
              <TextBlock x:Name="SettingsSearchPlaceholder" Text="Search" Foreground="{DynamicResource MutedBrush}" Margin="11,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
          </StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="60"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="WidgetEditorColumn" Width="0"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button x:Name="SettingsCogButton" Grid.Row="1" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="18" ToolTip="Settings" Width="44" Height="42" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="4,4,4,12" Background="Transparent" Click="SettingsNavButton_Click"/>
          </Grid>
        </Border>
        <Border Grid.Column="1" Padding="18,16" Background="Transparent">
          <Grid x:Name="WorkspaceGrid" AllowDrop="True" DragOver="WorkspaceGrid_DragOver" Drop="WorkspaceGrid_Drop" Background="Transparent"/>
        </Border>
        <Border x:Name="WidgetEditorPanel" Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="16" Visibility="Collapsed"
                AllowDrop="True" DragOver="WidgetRemoveDropZone_DragOver" DragLeave="WidgetRemoveDropZone_DragLeave" Drop="WidgetRemoveDropZone_Drop">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Edit dashboard" FontSize="19" FontWeight="Bold" Margin="0,0,0,3"/>
                <TextBlock Text="Drag a widget onto a panel edge to split the space. Drag dividers to resize." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
                <Border x:Name="WidgetRemoveDropZone" AllowDrop="True" DragOver="WidgetRemoveDropZone_DragOver" DragLeave="WidgetRemoveDropZone_DragLeave" Drop="WidgetRemoveDropZone_Drop"
                        Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,18">
                  <TextBlock Text="Drag a widget here to remove it" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="AVAILABLE WIDGETS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
                <StackPanel x:Name="AvailableWidgetsPanel"/>
                <TextBlock Text="ON DASHBOARD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
                <StackPanel x:Name="AddedWidgetsPanel"/>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
              <Button Content="Cancel" Width="88" Margin="0,0,8,0" Click="CancelDashboardEdit_Click"/>
              <Button Content="Save" Width="88" Background="{DynamicResource AccentBrush}" Foreground="White" Click="SaveDashboardEdit_Click"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    <Grid x:Name="IntroductionOverlay" Grid.RowSpan="2" Panel.ZIndex="1000" Background="Transparent" Visibility="Collapsed" SizeChanged="IntroductionOverlay_SizeChanged">
      <Canvas x:Name="IntroductionCanvas" ClipToBounds="True">
        <Path x:Name="IntroductionDimmer" Fill="#C9090E1A" IsHitTestVisible="False"/>
        <Border x:Name="IntroductionSpotlight" BorderBrush="#68C7FF" BorderThickness="3" CornerRadius="9" IsHitTestVisible="False"/>
        <Border x:Name="IntroductionSettingsButtonSpotlight" BorderBrush="#68C7FF" BorderThickness="3" CornerRadius="9" IsHitTestVisible="False" Visibility="Collapsed"/>
        <Border x:Name="WidgetGuidePreviewFrame" Visibility="Collapsed" BorderBrush="#68C7FF" BorderThickness="2" CornerRadius="12" ClipToBounds="True" IsHitTestVisible="False">
          <ContentPresenter x:Name="WidgetGuidePreviewHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Border>
        <Path x:Name="WidgetGuidePreviewDimmer" Visibility="Collapsed" Fill="#88090E1A" IsHitTestVisible="False"/>
        <Border x:Name="WidgetGuidePreviewSpotlight" Visibility="Collapsed" BorderBrush="#68C7FF" BorderThickness="3" CornerRadius="8" IsHitTestVisible="False"/>
        <Border x:Name="IntroductionCallout" Width="390" Padding="18" Background="{DynamicResource PanelBrush}" BorderBrush="#68C7FF" BorderThickness="2" CornerRadius="14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,9">
              <TextBlock x:Name="IntroductionStepTitle" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextBrush}"/>
              <TextBlock x:Name="IntroductionStepCounter" FontSize="11" Foreground="#68C7FF" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="IntroductionStepBody" Grid.Row="1" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" LineHeight="21"/>
            <DockPanel Grid.Row="2" LastChildFill="False" Margin="0,15,0,0">
              <Button Content="Skip" DockPanel.Dock="Left" Padding="13,7" Margin="0,0,16,0" Background="#492B36" Foreground="#FF8585" Click="IntroductionSkip_Click"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button x:Name="IntroductionBackButton" Content="Back" Padding="14,7" Margin="0,0,8,0" Click="IntroductionBack_Click"/>
                <Button x:Name="IntroductionNextButton" Content="Next" Padding="16,7" Background="{DynamicResource AccentBrush}" Foreground="White" Click="IntroductionNext_Click"/>
              </StackPanel>
            </DockPanel>
          </Grid>
        </Border>
      </Canvas>
    </Grid>
  </Grid>
  </Border>
</Window>
