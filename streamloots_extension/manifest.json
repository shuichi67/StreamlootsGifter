{
  "manifest_version": 3,
  "name": "Streamloots Gifter",
  "version": "0.5.7",
  "description": "Watches Streamloots Activity Feed card redeems and runs queued chest gifts.",
  "permissions": ["storage", "clipboardWrite", "tabs"],
  "host_permissions": [
    "https://www.streamloots.com/*",
    "https://streamloots.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Streamloots Gifter" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.streamloots.com/*", "https://streamloots.com/*"],
      "js": ["activity_feed_hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.streamloots.com/*", "https://streamloots.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
