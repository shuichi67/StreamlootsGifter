<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StreamlootsManager</RootNamespace>
    <AssemblyName>StreamlootsGifter</AssemblyName>
    <Version>0.6.1</Version>
    <ApplicationIcon>Assets\StreamlootsGifter.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\StreamlootsGifter.ico" />
    <EmbeddedResource Include="update_tools\update_signing_public.pem" LogicalName="StreamlootsManager.UpdateSigningPublicKey.pem" />
    <Compile Remove="update_tools\UpdateSigningTool\**\*.cs" />
  </ItemGroup>
</Project>
